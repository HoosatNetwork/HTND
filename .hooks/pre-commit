#!/bin/sh

set -eu

# Go pre-commit hook: gofmt + staticcheck

# VS Code (when launched from a GUI) may not inherit the same PATH as your shell,
# so Go tools installed via `go install` (typically under $GOPATH/bin) might not
# be found when the hook runs.
if command -v go >/dev/null 2>&1; then
    GO_BIN="$(go env GOBIN 2>/dev/null || true)"
    if [ -z "${GO_BIN:-}" ]; then
        GO_BIN="$(go env GOPATH 2>/dev/null || true)/bin"
    fi
    if [ -n "${GO_BIN:-}" ]; then
        PATH="$GO_BIN:$PATH"
        export PATH
    fi
fi

# Avoid failing when /tmp is full (staticcheck compiles packages and uses temp files).
# IMPORTANT: GOTMPDIR must be an *absolute* path. The Go toolchain may execute
# cgo/gcc from a different working directory; relative GOTMPDIR paths can cause
# intermittent "cgo: open ... no such file or directory" failures.
GIT_DIR_PATH="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
if [ -n "${GIT_DIR_PATH:-}" ]; then
    TMP_BASE="$GIT_DIR_PATH/.gotmp"
    mkdir -p "$TMP_BASE"
    TMPDIR="$TMP_BASE"
    GOTMPDIR="$TMP_BASE"
    export TMPDIR GOTMPDIR
fi

if ! command -v gofmt >/dev/null 2>&1; then
    echo "pre-commit: gofmt not found (PATH=$PATH)" >&2
    exit 1
fi

if ! command -v staticcheck >/dev/null 2>&1; then
    echo "pre-commit: staticcheck not found (PATH=$PATH)" >&2
    echo "Install: GOTMPDIR=$TMPDIR go install honnef.co/go/tools/cmd/staticcheck@latest" >&2
    exit 1
fi

# Find staged Go files (added, copied, modified)
STAGED_GO_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)"

if [ -n "$STAGED_GO_FILES" ]; then
	echo "pre-commit: running gofmt on staged Go files"
	printf '%s\n' "$STAGED_GO_FILES" | while IFS= read -r file; do
		[ -n "$file" ] || continue
		gofmt -w "$file"
		git add "$file"
	done
fi

echo "pre-commit: running staticcheck"
staticcheck ./...